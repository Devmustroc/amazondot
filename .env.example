# TAD Core Environment Configuration

# Echo Dot IP address on local network
DOT_HOST=192.168.1.23
DOT_MIC_PORT=9000
DOT_PLAY_PORT=9001
DOT_CTRL_PORT=9002

# Wake Word Model ("alexa" or "hey_jarvis")
WAKE_WORD_MODEL=alexa
WAKE_WORD_THRESHOLD=0.5

# Speech Processing
WHISPER_MODEL=tiny
TTS_VOICE=fr-FR-EloiseNeural
VAD_SILENCE_THRESHOLD=15.0
VAD_SILENCE_DURATION_SEC=1.2
MAX_RECORDING_SEC=10

# OpenRouter LLM (https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.0-flash-001
