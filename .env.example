# ==============================================================================
# SovereignDot — Environment Configuration Template
# Copy this file to .env and configure your preferences.
# ==============================================================================

# --- Assistant Identity & Family RBAC ---
ASSISTANT_NAME=Régis
FAMILY_ADMIN_NAME=Admin
FAMILY_CHILD_NAME=Enfant
WAKE_WORDS=régis,regis,alexa
WAKE_WORD_MODEL=alexa
WAKE_WORD_THRESHOLD=0.2

# --- Operating Mode ---
# Options: "echo_dot" (Amazon Echo Dot 2G hardware) or "local" (PC Microphone & Speaker)
AUDIO_INPUT_MODE=echo_dot

# --- Echo Dot 2G Hardware Network (When AUDIO_INPUT_MODE=echo_dot) ---
DOT_HOST=192.168.1.23
DOT_MIC_PORT=9000
DOT_PLAY_PORT=9001
DOT_CTRL_PORT=9002

# --- Voice Processing (STT & TTS) ---
WHISPER_MODEL=tiny
WHISPER_BEAM_SIZE=1
TTS_VOICE=fr-FR-VivienneMultilingualNeural
TTS_CACHE_ENABLED=true

# --- Offline Fallback & Resilience (Piper ONNX) ---
PIPER_ENABLED=true
CIRCUIT_BREAKER_MAX_FAILURES=2
CIRCUIT_BREAKER_RECOVERY_TIMEOUT_SEC=15.0
CIRCUIT_BREAKER_TTS_TIMEOUT_SEC=1.2

# --- LLM Providers & API Keys ---
# Local Ollama is used for fast zero-cost local private queries
OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=qwen2.5:latest

# OpenRouter (Cloud Reasoning & Tool Calling with Gemini 3.8 Flash)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.8-flash
OPENROUTER_ROUTER_MODEL=typesafe/jev-router

# --- Obsidian Knowledge Vault ---
# Path to your Obsidian vault notes directory for persistent facts & memory
OBSIDIAN_VAULT_PATH=/path/to/your/obsidian/vault/Memory

# --- Homelab SRE Supervision (Optional) ---
PROXMOX_HOST=192.168.1.200
PROXMOX_SSH_USER=root
PROXMOX_SSH_KEY=~/.ssh/id_ed25519
